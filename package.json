{
  "name": "qcomm",
  "private": true,
  "description": "Headless capture pipeline for Qualcomm Support cases",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "case": "node .claude/skills/qcomm/scripts/run_case.mjs",
    "case:summary": "node .claude/skills/qcomm/scripts/run_summary.mjs",
    "docs": "node tools/gen_design.mjs",
    "docs:check": "node tools/gen_design.mjs --check",
    "docs:hook": "git config core.hooksPath tools/hooks",
    "cases:overview": "node .claude/skills/qcomm/scripts/cases_overview.mjs",
    "cases:dashboard": "node .claude/skills/qcomm/scripts/cases_overview.mjs --open",
    "setup:protocol": "powershell -ExecutionPolicy Bypass -File scripts/register_protocol.ps1",
    "setup:credentials": "powershell -ExecutionPolicy Bypass -File .claude/skills/qcomm/scripts/setup/capture_credentials.ps1",
    "uninstall:protocol": "powershell -ExecutionPolicy Bypass -File scripts/unregister_protocol.ps1",
    "postinstall": "node scripts/ensure_protocol.mjs"
  },
  "engines": { "node": ">=22.3.0" },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
