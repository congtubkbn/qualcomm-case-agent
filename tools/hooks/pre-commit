#!/bin/sh
# Keep docs/DESIGN.md §7 in sync with the source on every commit, and refuse to
# commit session/credential paths.
# Install once per clone:  npm run docs:hook
set -e

# Refuse session/credential paths even when force-staged past .gitignore — runs on
# every commit, independent of which paths are staged.
node tools/guard_secrets.mjs

# Keep docs/DESIGN.md in sync. Only runs when a scanned source file is part of this
# commit, so a docs-only or data-only commit stays instant. If the generated block
# changes, it is added to the SAME commit — the doc can never lag the code it
# describes by a commit.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
case "$staged" in
  *.claude/skills/qcomm/scripts/*|*web/*|*tests/*|*tools/*|*package.json*) ;;
  *) exit 0 ;;
esac

node tools/gen_design.mjs
if ! git diff --quiet -- docs/DESIGN.md; then
  git add docs/DESIGN.md
  echo "pre-commit: refreshed docs/DESIGN.md (generated section) and staged it"
fi
